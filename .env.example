# Copy to .env and fill the key locally. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# deepseek = real API; mock = explicitly labeled offline template, no API calls.
LLM_MODE=deepseek
DATABASE_PATH=./data/demo.db
MODEL_TIMEOUT_SECONDS=120
MAX_RUNS_PER_OWNER_PER_DAY=20
MAX_RUNS_GLOBAL_PER_DAY=100
# Set true when serving over HTTPS.
COOKIE_SECURE=false
